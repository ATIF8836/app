                          ),
                        ),
                      ],
                    ),
                  )
                ],
              ),
              const SizedBox(height: 20),
              const Center(
                child: Text(
                  'LUDO',
                  style: TextStyle(
                    fontSize: 40,
                    fontWeight: FontWeight.w900,
                    color: Colors.white,
                    letterSpacing: 2,
                    shadows: [
                      Shadow(color: Colors.black38, blurRadius: 8),
                    ],
                  ),
                ),
              ),
              const SizedBox(height: 16),
              Row(
                children: [
                  buildMainCard(
                    context: context,
                    title: 'Play',
                    icon: Icons.casino,
                    colors: const [Color(0xFFFFD54F), Color(0xFFFFA000)],
                    onTap: () {
                      Navigator.push(
                        context,
                        MaterialPageRoute(builder: (_) => const PlayMenuScreen()),
                      );
                    },
                  ),
                  buildMainCard(
                    context: context,
                    title: 'Team',
                    icon: Icons.groups,
                    colors: const [Color(0xFF64B5F6), Color(0xFF1E88E5)],
