              ),
              Row(
                children: [
                  buildMainCard(
                    context: context,
                    title: 'Tournament',
                    icon: Icons.emoji_events,
                    colors: const [Color(0xFFFFB74D), Color(0xFFF57C00)],
                    onTap: () {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('Tournament feature coming next')),
                      );
                    },
                  ),
                  buildMainCard(
                    context: context,
                    title: 'VIP Room',
                    icon: Icons.workspace_premium,
                    colors: const [Color(0xFFF06292), Color(0xFFD81B60)],
                    badge: 'HOT',
                    onTap: () {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('VIP room feature coming next')),
                      );
                    },
